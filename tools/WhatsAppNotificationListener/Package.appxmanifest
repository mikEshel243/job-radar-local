<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 rescap">

  <Identity
    Name="JobRadar.WhatsAppNotificationListener"
    Publisher="CN=JobRadarLocal"
    Version="1.0.0.11"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Job Radar Notification Listener</DisplayName>
    <PublisherDisplayName>Job Radar Local</PublisherDisplayName>
    <Description>Local read-only Windows notification adapter for Job Radar</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.14393.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="App"
      Executable="WhatsAppNotificationListener.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Job Radar Notification Access Helper"
        Description="Local Windows notification permission helper for Job Radar"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="WhatsAppNotificationListener.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias
              Alias="JobRadarWhatsAppListener.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
    <Application
      Id="NativeListener"
      Executable="WhatsAppNotificationListenerNative.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Job Radar WhatsApp Notification Listener"
        Description="Local allowlisted WhatsApp notification listener"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="WhatsAppNotificationListenerNative.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias
              Alias="JobRadarWhatsAppNativeListener.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>
