# Local dashboard. Non-loopback values are rejected.
JOB_RADAR_HOST=127.0.0.1
JOB_RADAR_PORT=8000
JOB_RADAR_AUTO_REFRESH_MINUTES=0

# Automatic public collection is disabled by default.
JOB_RADAR_PUBLIC_REFRESH_MINUTES=0

# Optional Telegram read-only integration.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash
TELEGRAM_PHONE=replace_with_your_phone_number
TELEGRAM_CHANNEL_USERNAME=example_job_digest
TELEGRAM_CHANNEL_USERNAMES=example_job_digest
TELEGRAM_MESSAGE_LIMIT=10
